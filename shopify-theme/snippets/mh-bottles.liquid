{%- comment -%}
  Number of bottles in a variant, read from the variant title.

  Outputs a bare integer, so callers capture it:

    {%- capture bottles %}{% render 'mh-bottles', mh_variant: variant %}{% endcapture -%}
    {%- assign bottles = bottles | plus: 0 -%}

  Understands "1 Flasche", "3 Flaschen", "3 × 100 ml", "3x", and the old
  volume-only titles ("300ml" → 300 / bottle volume = 3). Anything it cannot
  read counts as one bottle. A block setting (mh_bottles) always wins.

  Accepts:
    mh_variant   a variant object
    mh_bottles   explicit count from a block setting (0 / blank = read title)
{%- endcomment -%}
{%- liquid
  assign count = mh_bottles | default: 0 | plus: 0
  if count < 1
    assign title = mh_variant.title | downcase | strip
    assign first = title | split: ' ' | first | remove: '×' | remove: 'x' | remove: '*' | remove: 'ml' | strip
    assign count = first | plus: 0
    if count > 12
      assign volume = settings.bottle_volume_ml | default: 100 | plus: 0
      if volume < 1
        assign volume = 100
      endif
      assign remainder = count | modulo: volume
      if remainder == 0
        assign count = count | divided_by: volume
      else
        assign count = 1
      endif
    endif
  endif
  if count < 1 or count > 12
    assign count = 1
  endif
-%}{{ count }}
