{%- comment -%}
  Emits the variant data myhaut.js needs to keep the hero, the sticky bar and
  the bundle cards in sync. Prices are formatted in Liquid so the shop's money
  format and currency always win.

  Accepts:
    mh_product   a product object
{%- endcomment -%}

{%- if mh_product != blank -%}
  <script type="application/json" data-mh-product-data>
    {
      "id": {{ mh_product.id }},
      "url": {{ mh_product.url | json }},
      "default_id": {{ mh_product.first_available_variant.id | default: mh_product.variants.first.id | json }},
      "selected_id": {{ mh_product.selected_variant.id | json }},
      "variants": [
        {%- for variant in mh_product.variants -%}
          {%- liquid
            assign bottles = variant.title | split: ' ' | first | remove: '×' | remove: 'x' | remove: 'X' | remove: '*' | plus: 0
            if bottles < 1
              assign bottles = 1
            endif
            assign unit_price = ''
            if bottles > 1
              assign unit_cents = variant.price | divided_by: bottles
              assign unit_price = unit_cents | money
            endif
            assign discount_percent = 0
            if variant.compare_at_price > variant.price
              assign price_difference = variant.compare_at_price | minus: variant.price
              assign rounding = variant.compare_at_price | divided_by: 2
              assign discount_percent = price_difference | times: 100 | plus: rounding | divided_by: variant.compare_at_price
            endif
          -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available }},
            "price": {{ variant.price | money | json }},
            "compare_at": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "discount_percent": {{ discount_percent }},
            "bottles": {{ bottles }},
            "unit_price": {% if unit_price != blank %}{{ unit_price | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
