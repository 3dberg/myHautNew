{%- comment -%}
  Emits the variant data myhaut.js needs to keep the hero, the sticky bar and
  the bundle cards in sync. Prices are formatted in Liquid so the shop's money
  format and currency always win.

  Accepts:
    mh_product            a product object
    mh_default_position   1-based variant position to preselect when the URL
                          carries no ?variant= (0 / blank = first available)
    mh_extras             value in € of non-spray items in the set, taken
                          off before the unit / base price is worked out
    mh_bottles            bottles per variant for the unit / base price
                          (0 / blank = read each variant's title)
{%- endcomment -%}

{%- liquid
  assign hide_discounts = true
  if settings.show_compare_prices
    assign hide_discounts = false
  endif
-%}

{%- liquid
  comment
    Price of one bottle: the first variant that holds exactly one, else the
    cheapest variant. Sets show their saving against this.
  endcomment
  assign single_cents = 0
  for variant in mh_product.variants
    capture variant_bottles
      render 'mh-bottles', mh_variant: variant, mh_bottles: mh_bottles
    endcapture
    assign variant_bottles = variant_bottles | plus: 0
    if variant_bottles == 1 and single_cents == 0
      assign single_cents = variant.price
    endif
  endfor
  if single_cents == 0
    assign single_cents = mh_product.variants | map: 'price' | sort | first | default: 0
  endif
  assign free_cents = settings.free_shipping_threshold | default: 0 | times: 100

  assign default_variant = mh_product.first_available_variant | default: mh_product.variants.first
  assign default_position = mh_default_position | default: 0 | plus: 0
  if default_position > 0
    assign default_index = default_position | minus: 1
    assign preset_variant = mh_product.variants[default_index]
    if preset_variant != blank and preset_variant.available
      assign default_variant = preset_variant
    endif
  endif
-%}

{%- if mh_product != blank -%}
  <script type="application/json" data-mh-product-data>
    {
      "id": {{ mh_product.id }},
      "url": {{ mh_product.url | json }},
      "default_id": {{ default_variant.id | json }},
      "selected_id": {{ mh_product.selected_variant.id | json }},
      "variants": [
        {%- for variant in mh_product.variants -%}
          {%- liquid
            capture bottles
              render 'mh-bottles', mh_variant: variant, mh_bottles: mh_bottles
            endcapture
            assign bottles = bottles | plus: 0
            assign extras_cents = mh_extras | default: 0 | times: 100 | round
            assign spray_cents = variant.price | minus: extras_cents
            if spray_cents < 0
              assign spray_cents = 0
            endif
            assign unit_cents = spray_cents | divided_by: bottles
            assign unit_price = ''
            if bottles > 1
              assign unit_price = unit_cents | money
            endif

            comment
              Grundpreis per 100 ml — see snippets/mh-base-price.liquid.
            endcomment
            assign volume = settings.bottle_volume_ml | default: 100 | plus: 0
            if volume < 1
              assign volume = 100
            endif
            assign base_cents = unit_cents | times: 100 | divided_by: volume
            assign base_price = base_cents | money

            assign discount_percent = 0
            if variant.compare_at_price > variant.price and hide_discounts == false
              assign price_difference = variant.compare_at_price | minus: variant.price
              assign rounding = variant.compare_at_price | divided_by: 2
              assign discount_percent = price_difference | times: 100 | plus: rounding | divided_by: variant.compare_at_price
            endif

            comment
              What a set saves against buying the same number of single
              bottles, and whether it clears the free-shipping threshold.
            endcomment
            assign saving_cents = single_cents | times: bottles | minus: variant.price
            assign saving = ''
            if bottles > 1 and saving_cents > 0
              assign saving = saving_cents | money
            endif
            assign free_shipping = false
            if free_cents > 0 and variant.price >= free_cents
              assign free_shipping = true
            endif
          -%}
          {
            "id": {{ variant.id }},
            "title": {% if mh_product.has_only_default_variant %}{{ mh_product.title | json }}{% else %}{{ variant.title | json }}{% endif %},
            "available": {{ variant.available }},
            "price": {{ variant.price | money | json }},
            "compare_at": {% if discount_percent > 0 %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "discount_percent": {{ discount_percent }},
            "bottles": {{ bottles }},
            "unit_price": {% if unit_price != blank %}{{ unit_price | json }}{% else %}null{% endif %},
            "base_price": {{ base_price | json }},
            "saving": {% if saving != blank %}{{ saving | json }}{% else %}null{% endif %},
            "saving_cents": {{ saving_cents | at_least: 0 }},
            "free_shipping": {{ free_shipping }},
            "media_id": {{ variant.featured_media.id | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
