{%- comment -%}
  Social icons, driven by Theme settings → Social media. The same set renders
  everywhere it is used; only the colour and the size differ per placement, and
  both of those come from CSS. Renders nothing when no link is set, so an empty
  setting never leaves a stray row of icons.

  Accepts:
    mh_social_modifier   extra class, e.g. 'mh-social--footer' (optional)

  Usage:
    {% render 'mh-social', mh_social_modifier: 'mh-social--footer' %}
{%- endcomment -%}

{%- liquid
  assign networks = 'instagram,facebook,tiktok,pinterest,youtube' | split: ','

  assign has_any = false
  if settings.social_instagram_link != blank
    assign has_any = true
  endif
  if settings.social_facebook_link != blank
    assign has_any = true
  endif
  if settings.social_tiktok_link != blank
    assign has_any = true
  endif
  if settings.social_pinterest_link != blank
    assign has_any = true
  endif
  if settings.social_youtube_link != blank
    assign has_any = true
  endif
-%}

{%- if has_any -%}
  <div class="mh-social {{ mh_social_modifier }}">
    {%- for network in networks -%}
      {%- liquid
        case network
          when 'instagram'
            assign url = settings.social_instagram_link
            assign label = 'Instagram'
          when 'facebook'
            assign url = settings.social_facebook_link
            assign label = 'Facebook'
          when 'tiktok'
            assign url = settings.social_tiktok_link
            assign label = 'TikTok'
          when 'pinterest'
            assign url = settings.social_pinterest_link
            assign label = 'Pinterest'
          when 'youtube'
            assign url = settings.social_youtube_link
            assign label = 'YouTube'
        endcase
      -%}

      {%- if url != blank -%}
        <a
          href="{{ url }}"
          class="mh-social__link"
          target="_blank"
          rel="noopener"
          aria-label="{{ 'general.accessibility.social_link' | t: network: label }}">
