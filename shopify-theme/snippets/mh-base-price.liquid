{%- comment -%}
  Grundpreis — the price per 100 ml.

  German price-indication law (§ 4 PAngV) requires a base price next to the
  total price for anything sold by volume, so every place that prints a price
  in this theme prints this line underneath it.

  Accepts:
    mh_variant   a variant object
    mh_bottles   bottles in this variant (0 / blank = read it from the title)
    mh_class     extra class names
    mh_dynamic   true to let myhaut.js keep it in sync with the selected variant
{%- endcomment -%}

{%- if settings.show_base_price and mh_variant != blank -%}
  {%- liquid
    capture bottles
      render 'mh-bottles', mh_variant: mh_variant, mh_bottles: mh_bottles
    endcapture
    assign bottles = bottles | plus: 0

    assign volume = settings.bottle_volume_ml | default: 100 | plus: 0
    if volume < 1
      assign volume = 100
    endif

    assign per_bottle_cents = mh_variant.price | divided_by: bottles
    assign per_unit_cents = per_bottle_cents | times: 100 | divided_by: volume
    assign base_price = per_unit_cents | money
  -%}
  <div
    class="mh-base-price {{ mh_class }}"
    {% if mh_dynamic %}data-mh-base-price{% endif %}>
    {{- 'products.product.base_price' | t: price: base_price -}}
  </div>
{%- endif -%}
