          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "placeholder": "Schritt 3 \u2014 Abwischen mit feuchtem Tuch"
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3"
      ],
