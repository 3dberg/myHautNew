{
  "sections": {
    "hero": {
      "type": "mh-hero",
      "settings": {
        "show_rating": true,
        "rating_stars": 5,
        "featured_position": 3,
        "secondary_target": "#mh-bundles",
        "full_width": false,
        "height_mode": "image",
        "height": 660,
        "height_mobile": 400
      }
    },
    "sticky": {
      "type": "mh-sticky-atc",
      "settings": {
        "show_thumbnail": true,
        "show_chip_savings": true,
        "reveal_after": ".mh-hero"
