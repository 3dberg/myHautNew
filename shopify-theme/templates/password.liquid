<div class="mh-container">
  <h1 class="mh-page__title" style="font-family: var(--mh-serif)">{{ shop.name }}</h1>
  <p class="mh-page__intro">{{ 'password_page.message' | t }}</p>

  {%- form 'storefront_password', class: 'mh-form', style: 'margin: 32px auto 0' -%}
    {{ form.errors | default_errors }}
    <div class="mh-field">
      <label for="mh-password">{{ 'password_page.login_password' | t }}</label>
      <input type="password" id="mh-password" name="password">
    </div>
    <button type="submit" class="mh-btn">{{ 'password_page.login_submit' | t }}</button>
  {%- endform -%}

  <p style="margin-top: 28px; font-size: 13px">
    {{ 'password_page.admin_link' | t }}
    <a href="https://{{ shop.permanent_domain }}/admin">{{ 'password_page.admin_link_text' | t }}</a>
  </p>
</div>
