<div class="mh-page">
  <div class="mh-container">
    <h1 class="mh-page__title">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'mh-form' -%}
      {{ form.errors | default_errors }}
      <div class="mh-field">
        <label for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="reset-password" name="customer[password]" autocomplete="new-password">
      </div>
      <div class="mh-field">
        <label for="reset-password-confirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="reset-password-confirm" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button type="submit" class="mh-btn">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
