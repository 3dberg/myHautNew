{%- comment -%}
  In pre-order mode there is nothing to buy, so the cart button is dead weight
  and the social icons take its place. The exception is the "Jetzt vorbestellen
  →" link (preorder_show_checkout), which really does add to the cart — with
  that on the cart has to stay reachable and the icons sit to its left instead.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign cart_label = 'sections.header.cart' | t
  assign cart_label_short = 'sections.header.cart_short' | t

  assign show_cart = true
  if settings.preorder_mode and settings.preorder_show_checkout != true
    assign show_cart = false
  endif

  assign social_modifier = 'mh-social--header'
  unless show_cart
    assign social_modifier = 'mh-social--header mh-social--header-solo'
  endunless

  # The header logo is its own image and its own size, independent of the
  # footer's. Both fall back to the shop-wide logo so an untouched theme looks
  # exactly as before: width 0 means "use Theme settings → Brand", height 0
  # means "keep the image's proportions".
  assign logo = section.settings.logo | default: settings.logo
  assign logo_width = section.settings.logo_width
  if logo_width == 0 or logo_width == blank
    assign logo_width = settings.logo_width
  endif
  assign logo_height = section.settings.logo_height

  capture logo_style
    echo 'width:'
    echo logo_width
    echo 'px;'
    if logo_height > 0
      echo 'height:'
      echo logo_height
      echo 'px;object-fit:contain;'
    endif
  endcapture
-%}

<header class="mh-header">
  <div class="mh-header__inner">
    <div class="mh-header__start">
      <button
        type="button"
        class="mh-header__burger"
        data-mh-nav-toggle
        aria-expanded="false"
        aria-controls="mh-mobile-nav"
        aria-label="{{ 'general.accessibility.open_menu' | t }}">
        ☰
      </button>

      <nav class="mh-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        {%- for link in linklists[menu].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>

    <div class="mh-header__logo">
      <a href="{{ routes.root_url }}" style="color: inherit">
        {%- if logo != blank -%}
          {{
            logo
            | image_url: width: 600
            | image_tag: widths: '140, 280, 420, 600', sizes: '220px', alt: shop.name, style: logo_style
          }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
    </div>

    <div class="mh-header__actions">
      {%- if section.settings.show_locale_switcher
        and localization.available_languages.size > 1
      -%}
        <div class="mh-header__locale">
          {%- form 'localization', class: 'mh-header__locale-form' -%}
            <label class="mh-visually-hidden" for="mh-locale">{{ 'general.language.label' | t }}</label>
            <select id="mh-locale" name="locale_code" onchange="this.form.submit()">
              {%- for language in localization.available_languages -%}
                <option
                  value="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                  {{ language.endonym_name | upcase }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {% render 'mh-social', mh_social_modifier: social_modifier %}
      {%- endif -%}

      {%- if show_cart -%}
        <a href="{{ routes.cart_url }}" class="mh-header__cart" data-mh-cart-open>
          <span class="mh-header__cart-label--long">{{ cart_label }}</span>
          <span class="mh-header__cart-label--short">{{ cart_label_short }}</span>
          <span class="mh-header__count" data-mh-cart-count>{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="mh-mobile-nav" id="mh-mobile-nav" data-mh-nav>
    {%- for link in linklists[menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "mh-section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_locale_switcher", "label": "Show language switcher", "default": true },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Links come from Theme settings → Social media. In pre-order mode they replace the cart button; in normal sales mode they sit to its left."
    },
    { "type": "header", "content": "Logo" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Leave empty to use Theme settings → Brand → Logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "info": "0 = use the width from Theme settings → Brand."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0,
      "info": "0 = automatic, keeps the image's own proportions. Set a height and the logo is fitted inside it without distorting."
    }
  ]
}
{% endschema %}
