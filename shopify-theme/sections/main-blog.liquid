<div class="mh-page">
  <div class="mh-container">
    <h1 class="mh-page__title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="mh-grid-products">
        {%- for article in blog.articles -%}
          <div class="mh-card">
            <a href="{{ article.url }}">
              {%- if article.image -%}
                <div class="mh-card__media">
                  {% render 'mh-media', mh_image: article.image, mh_alt: article.title, mh_sizes: '(min-width: 700px) 25vw, 50vw' %}
                </div>
              {%- endif -%}
              <span class="mh-card__title">{{ article.title }}</span>
            </a>
            {%- assign published = article.published_at | date: format: 'date' -%}
            <div class="mh-card__price">{{ 'blogs.article.posted_on' | t: date: published }}</div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="mh-pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
