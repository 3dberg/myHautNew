{%- comment -%}
  Bundle cards. Each card points at one variant of the product by its
  position in the variant list (1 = first variant in the Shopify admin).
{%- endcomment -%}

{%- liquid
  assign mh_product = section.settings.product | default: product | default: collections.all.products.first
  assign current_variant = mh_product.selected_or_first_available_variant

  assign fallback_eyebrow = 'sections.bundles.eyebrow' | t
  assign fallback_heading = 'sections.bundles.heading' | t
  assign fallback_body = 'sections.bundles.body' | t
  assign bestseller_word = 'sections.bundles.badge_bestseller' | t

  comment
    In pre-order mode picking a bundle is not a purchase — it sets which
    variant the waitlist form will be tagged with and scrolls the visitor to
    it. The cta_action setting below only applies once pre-order mode is off.
  endcomment
  assign card_action = section.settings.cta_action | default: 'add'
  assign card_scroll = '#mh-buy'
  assign fallback_select = 'sections.bundles.select' | t

  assign hide_discounts = true
  if settings.show_compare_prices
    assign hide_discounts = false
  endif

  assign lock_unavailable = true
  if settings.preorder_mode
    assign lock_unavailable = false
    assign card_action = 'scroll'
    assign card_scroll = settings.waitlist_anchor | default: '#mh-vormerken'
    assign fallback_select = 'sections.bundles.select_preorder' | t
  endif

  assign eyebrow = section.settings.eyebrow | default: fallback_eyebrow
  assign heading = section.settings.heading | default: fallback_heading
  assign intro = section.settings.body | default: fallback_body
  assign select_label = section.settings.select_label | default: fallback_select

  assign fallback_trust_1 = 'sections.bundles.trust_1' | t
  assign fallback_trust_2 = 'sections.bundles.trust_2' | t
  assign fallback_trust_3 = 'sections.bundles.trust_3' | t

  comment
    The single-bottle price every set is measured against, and the
    free-shipping threshold in cents (0 = off).
  endcomment
  assign single_index = section.settings.single_position | default: 1 | minus: 1
  assign single_variant = mh_product.variants[single_index]
  assign single_cents = single_variant.price | default: 0
  assign free_cents = settings.free_shipping_threshold | default: 0 | times: 100
  assign volume = settings.bottle_volume_ml | default: 100 | plus: 0
  if volume < 1
    assign volume = 100
  endif
-%}

<div class="mh-bundles" id="{{ section.settings.anchor | default: 'mh-bundles' }}">
  <div class="mh-container">
    <div class="mh-bundles__head">
      {%- if eyebrow != blank -%}<div class="mh-eyebrow">{{ eyebrow }}</div>{%- endif -%}
      <h2 class="mh-bundles__title">{{ heading | newline_to_br }}</h2>
      {%- if intro != blank -%}<p class="mh-bundles__intro">{{ intro }}</p>{%- endif -%}
    </div>

    {%- if mh_product == blank -%}
      <p class="mh-bundles__intro">{{ 'products.product.no_product' | t }}</p>
    {%- else -%}
      {% render 'mh-product-data', mh_product: mh_product %}

      <div
        class="mh-bundles__grid"
        style="--mh-bundle-image-height: {{ section.settings.image_height | default: 160 }}px">
        {%- for block in section.blocks -%}
          {%- liquid
            assign position = block.settings.variant_position | default: forloop.index
            assign index = position | minus: 1
            assign variant = mh_product.variants[index]

            assign eyebrow_key = 'sections.bundles.card_' | append: forloop.index | append: '_eyebrow'
            assign title_key = 'sections.bundles.card_' | append: forloop.index | append: '_title'
            assign fallback_card_eyebrow = eyebrow_key | t
            assign fallback_card_title = title_key | t
            if fallback_card_eyebrow contains 'translation missing'
              assign fallback_card_eyebrow = ''
            endif
            if fallback_card_title contains 'translation missing'
              assign fallback_card_title = ''
            endif
            assign card_eyebrow = block.settings.eyebrow | default: fallback_card_eyebrow

            comment
              Card image: the variant's own image when one is assigned in the
              Shopify admin, otherwise the product's featured image. The block
              setting overrides both, for a bundle shot showing three bottles
              where the variant only has a single-bottle photo.
            endcomment
            assign card_image = block.settings.image | default: variant.image | default: mh_product.featured_image

            capture bottles
              render 'mh-bottles', mh_variant: variant, mh_bottles: block.settings.bottles
            endcapture
            assign bottles = bottles | plus: 0

            comment
              Card title: block setting, then the translated "3 Flaschen", then
              the variant title as it is in the admin.
            endcomment
            assign card_title = block.settings.title | default: fallback_card_title | default: variant.title

            assign unit_cents = variant.price | divided_by: bottles
            assign unit_price = ''
            if bottles > 1
              assign unit_price = unit_cents | money
            endif
            assign single_price = single_cents | money

            assign saving_cents = single_cents | times: bottles | minus: variant.price
            assign saving = ''
            if bottles > 1 and saving_cents > 0
              assign saving = saving_cents | money
            endif

            assign free_shipping = false
            if free_cents > 0 and variant.price >= free_cents
              assign free_shipping = true
            endif

            assign discount_percent = 0
            if variant.compare_at_price > variant.price and hide_discounts == false
              assign price_difference = variant.compare_at_price | minus: variant.price
              assign rounding = variant.compare_at_price | divided_by: 2
              assign discount_percent = price_difference | times: 100 | plus: rounding | divided_by: variant.compare_at_price
            endif

            assign flag_text = block.settings.flag
            if flag_text == blank and block.settings.featured
              assign flag_text = bestseller_word
              comment
                Nothing has sold yet, so nothing is a bestseller — in pre-order
                mode the highlighted card says it is our recommendation instead.
              endcomment
              if settings.preorder_mode
                assign flag_text = 'sections.bundles.badge_recommended' | t
              endif
            endif
          -%}

          {%- if variant != blank -%}
            <div
              class="mh-bundle{% if block.settings.featured %} mh-bundle--featured{% endif %}{% if variant.id == current_variant.id %} is-selected{% endif %}"
              {{ block.shopify_attributes }}>
              {%- if flag_text != blank -%}
                <div class="mh-bundle__flag">{{ flag_text }}</div>
              {%- endif -%}

              {%- if section.settings.show_images -%}
                <div class="mh-bundle__media">
                  {% render 'mh-media',
                    mh_image: card_image,
                    mh_fallback: 'mh-demo-product.png',
                    mh_class: 'mh-media--contain',
                    mh_alt: card_title,
                    mh_sizes: '(min-width: 1000px) 300px, 45vw'
                  %}
                  {%- if discount_percent > 0 -%}
                    <span class="mh-bundle__off">{{ 'products.product.save_percent' | t: percent: discount_percent }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if card_eyebrow != blank -%}
                <div class="mh-bundle__eyebrow">{{ card_eyebrow }}</div>
              {%- endif -%}
              <div class="mh-bundle__title">{{ card_title }}</div>
              <div class="mh-bundle__sub">
                {{- 'sections.bundles.bottles_volume' | t: count: bottles, volume: volume -}}
                {%- if free_shipping %} <span class="mh-bundle__ship">{{ 'sections.bundles.free_shipping_badge' | t }}</span>{% endif -%}
              </div>

              <div class="mh-bundle__price">
                <span class="mh-bundle__price-current">{{ variant.price | money }}</span>
                {%- if discount_percent > 0 -%}
                  <s class="mh-bundle__price-compare">{{ variant.compare_at_price | money }}</s>
                {%- endif -%}
              </div>

              {%- if unit_price != blank -%}
                <div class="mh-bundle__unit">
                  {{- 'sections.bundles.per_bottle' | t: price: unit_price }}
                  {%- if single_cents > unit_cents %} <span class="mh-bundle__vs">{{ 'sections.bundles.vs_single' | t: price: single_price }}</span>{% endif -%}
                </div>
              {%- endif -%}
              {%- if saving != blank -%}
                <div class="mh-bundle__saving">{{ 'sections.bundles.saving' | t: amount: saving }}</div>
              {%- endif -%}
              {% render 'mh-base-price', mh_variant: variant, mh_bottles: bottles, mh_class: 'mh-bundle__base' %}

              <button
                type="button"
                class="mh-btn mh-bundle__cta {% if block.settings.featured %}mh-btn--primary{% else %}mh-btn--outline{% endif %}"
                data-mh-select="{{ variant.id }}"
                data-mh-select-action="{{ card_action }}"
                data-mh-select-scroll="{{ card_scroll }}"
                data-mh-add-label-text="{{ select_label | escape }}"
                aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                {% if lock_unavailable and variant.available == false %}disabled{% endif %}>
                <span data-mh-add-label>
                  {%- if variant.available or settings.preorder_mode -%}
                    {{ select_label }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% render 'mh-tax-note', mh_class: 'mh-bundles__tax' %}

    <div class="mh-bundles__trust">
      {%- assign trust_1 = section.settings.trust_1 | default: fallback_trust_1 -%}
      {%- assign trust_2 = section.settings.trust_2 | default: fallback_trust_2 -%}
      {%- assign trust_3 = section.settings.trust_3 | default: fallback_trust_3 -%}
      {%- if trust_1 != blank -%}<span>✓ {{ trust_1 }}</span>{%- endif -%}
      {%- if trust_2 != blank -%}<span>✓ {{ trust_2 }}</span>{%- endif -%}
      {%- if trust_3 != blank -%}<span>✓ {{ trust_3 }}</span>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "mh-section-bundles",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Required on the homepage. On the product template the current product is used automatically."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Headline" },
    { "type": "textarea", "id": "body", "label": "Intro text" },
    { "type": "text", "id": "select_label", "label": "Button label" },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show a product image on each card",
      "default": true,
      "info": "Uses the image assigned to that variant in the Shopify admin, falling back to the product's featured image. Assign a photo per variant (Products → Variants → image) so each bundle shows the right number of bottles."
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 100,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 160
    },
    {
      "type": "range",
      "id": "single_position",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Single-bottle variant (position in the admin)",
      "default": 1,
      "info": "The sets show what they save against buying this many single bottles."
    },
    {
      "type": "select",
      "id": "cta_action",
      "label": "What the button does",
      "info": "Ignored while pre-order mode is on: the card then selects the bundle and scrolls to the waitlist.",
      "options": [
        { "value": "select", "label": "Select the bundle" },
        { "value": "scroll", "label": "Select and scroll to the buy box" },
        { "value": "add", "label": "Add to cart straight away" }
      ],
      "default": "add"
    },
    { "type": "header", "content": "Trust row" },
    { "type": "text", "id": "trust_1", "label": "Item 1" },
    { "type": "text", "id": "trust_2", "label": "Item 2" },
    { "type": "text", "id": "trust_3", "label": "Item 3" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "mh-bundles" }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle card",
      "settings": [
        {
          "type": "range",
          "id": "variant_position",
          "min": 1,
          "max": 12,
          "step": 1,
          "label": "Variant (position in the admin)",
          "default": 1
        },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the variant name." },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Overrides the variant image — use it for a bundle shot showing the actual number of bottles."
        },
        {
          "type": "range",
          "id": "bottles",
          "min": 0,
          "max": 12,
          "step": 1,
          "label": "Bottles in this bundle",
          "default": 0,
          "info": "Used for the “per bottle” price. 0 = read it from the variant name."
        },
        { "type": "checkbox", "id": "featured", "label": "Highlight this card", "default": false },
        { "type": "text", "id": "flag", "label": "Flag text", "info": "Defaults to “Bestseller · save X %” on the highlighted card." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        { "type": "bundle", "settings": { "variant_position": 1 } },
        { "type": "bundle", "settings": { "variant_position": 2 } },
        { "type": "bundle", "settings": { "variant_position": 3, "featured": true } },
        { "type": "bundle", "settings": { "variant_position": 4 } }
      ]
    }
  ]
}
{% endschema %}
