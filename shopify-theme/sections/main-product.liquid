{%- comment -%}
  Plain product page — used by the "product.simple" template for any product
  that is not the landing-page product.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign lock_unavailable = true
  if settings.preorder_mode
    assign lock_unavailable = false
  endif
-%}

<div class="mh-container">
  <div class="mh-product">
    <div class="mh-product__media">
      {% render 'mh-media',
        mh_image: product.featured_image,
        mh_alt: product.title,
        mh_ratio: '1 / 1',
        mh_sizes: '(min-width: 700px) 50vw, 100vw'
      %}
    </div>

    <div>
      <h1 class="mh-product__title">{{ product.title }}</h1>
      {% render 'mh-loox-rating', mh_product: product, mh_class: 'mh-rating--product', mh_target: '' %}
      {% render 'mh-price', mh_variant: current_variant %}
      {% render 'mh-product-data', mh_product: product %}

      {%- form 'product', product, class: 'mh-product__form', data-mh-form: 'true' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-mh-form-variant>
        <input type="hidden" name="quantity" value="1">

        {%- if product.variants.size > 1 -%}
          <div class="mh-options" role="group" aria-label="{{ 'products.product.quantity' | t }}">
            {%- for variant in product.variants -%}
              <button
                type="button"
                class="mh-option{% if variant.id == current_variant.id %} is-active{% endif %}"
                data-mh-select="{{ variant.id }}"
                aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                {% if lock_unavailable and variant.available == false %}disabled{% endif %}>
                <span class="mh-option__meta"><span>{{ variant.title }}</span></span>
                <span class="mh-option__price">{{ variant.price | money }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          This template is not the landing page, so it has no waitlist section
          of its own — send people to the interest page, or to the anchor on
          the home page if none is configured.
        {%- endcomment -%}
        {%- liquid
          assign product_waitlist_href = settings.interest_page
          if product_waitlist_href == blank
            assign home_anchor = settings.waitlist_anchor | default: '#mh-vormerken'
            assign product_waitlist_href = routes.root_url | append: home_anchor
          endif
        -%}
        {% render 'mh-buy-actions',
          mh_variant: current_variant,
          mh_modifier: 'mh-btn--block',
          mh_submit: true,
          mh_href: product_waitlist_href,
          mh_context: 'product'
        %}
      {%- endform -%}

      {%- if settings.preorder_mode and settings.preorder_ship_text != blank -%}
        <p class="mh-product__ship">{{ settings.preorder_ship_text }}</p>
      {%- endif -%}

      <div class="mh-rte" style="margin-top: 28px; color: var(--mh-body); line-height: 1.7">
        {{ product.description }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
