{%- comment -%}
  Four benefits with a line icon each — the "why this" row under the buy box.
{%- endcomment -%}

{%- liquid
  assign fallback_heading = 'sections.benefits.heading' | t
  assign heading = section.settings.heading | default: fallback_heading
-%}

{%- if section.blocks.size > 0 -%}
  <div class="mh-benefits" id="{{ section.settings.anchor | default: 'mh-vorteile' }}">
    <div class="mh-container">
      {%- if heading != blank -%}<h2 class="mh-benefits__title">{{ heading | newline_to_br }}</h2>{%- endif -%}
      <div class="mh-benefits__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign title_key = 'sections.benefits.item_' | append: forloop.index | append: '_title'
            assign body_key = 'sections.benefits.item_' | append: forloop.index | append: '_body'
            assign fallback_title = title_key | t
            assign fallback_body = body_key | t
            if fallback_title contains 'translation missing'
              assign fallback_title = ''
            endif
            if fallback_body contains 'translation missing'
              assign fallback_body = ''
            endif
            assign item_title = block.settings.title | default: fallback_title
            assign item_body = block.settings.body | default: fallback_body
            assign icon = block.settings.icon | default: 'body'
          -%}
          {%- if item_title != blank -%}
            <div class="mh-benefit" {{ block.shopify_attributes }}>
              <span class="mh-benefit__icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  {%- case icon -%}
                    {%- when 'people' -%}<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.5A5 5 0 0 1 22 19"/>
                    {%- when 'spray' -%}<path d="M9 8h6v13H9z"/><path d="M10 8V5h4v3"/><path d="M12 5V3"/><path d="M17 5l2-1M17 8h2.5M17 11l2 1"/>
                    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14z"/><path d="M5 19l8-8"/>
                    {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
                    {%- else -%}<path d="M9 3c-2 3-3 6-3 9 0 4 2 7 6 9 4-2 6-5 6-9 0-3-1-6-3-9"/><path d="M9 12h6"/>
                  {%- endcase -%}
                </svg>
              </span>
              <h3 class="mh-benefit__title">{{ item_title }}</h3>
              {%- if item_body != blank -%}<p class="mh-benefit__body">{{ item_body }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "mh-section-benefits",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Headline", "info": "Optional." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "mh-vorteile" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "people", "label": "People" }, { "value": "spray", "label": "Spray bottle" },
          { "value": "leaf", "label": "Leaf" }, { "value": "clock", "label": "Clock" }, { "value": "body", "label": "Body" } ], "default": "body" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Benefits", "blocks": [
    { "type": "benefit", "settings": { "icon": "people" } }, { "type": "benefit", "settings": { "icon": "spray" } },
    { "type": "benefit", "settings": { "icon": "leaf" } }, { "type": "benefit", "settings": { "icon": "clock" } } ] } ]
}
{% endschema %}
