<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- if settings.use_google_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap"
        media="print"
        onload="this.media='all'">
      <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap">
      </noscript>
    {%- else -%}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ content_for_header }}

    {{ 'myhaut.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --mh-bg: {{ settings.color_background }};
        --mh-sand: {{ settings.color_band }};
        --mh-blush: {{ settings.color_image_placeholder }};
        --mh-rose: {{ settings.color_accent }};
        --mh-rose-dark: {{ settings.color_accent_dark }};
        --mh-rose-tint: {{ settings.color_accent_tint }};
        --mh-ink: {{ settings.color_ink }};
        --mh-body: {{ settings.color_text }};
        --mh-muted: {{ settings.color_muted }};
        --mh-line: {{ settings.color_line }};
        {%- unless settings.use_google_fonts %}
          --mh-serif: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
          --mh-sans: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        {%- endunless %}
        --mh-page: {{ settings.page_width }}px;
      }
    </style>

    {%- comment -%}
      The two tokens below stay unresolved on purpose: myhaut.js fills them in
      client-side when the selected variant changes.
    {%- endcomment -%}
    {%- assign token_percent = '{{ percent ' | append: '}}' -%}
    {%- assign token_price = '{{ price ' | append: '}}' -%}
    {%- assign string_save_percent = 'sections.bundles.save_percent' | t: percent: token_percent -%}
    {%- assign string_save_short = 'products.product.save_percent' | t: percent: token_percent -%}
    {%- assign string_per_bottle = 'sections.bundles.per_bottle' | t: price: token_price -%}

    <script>
      window.MyHautConfig = {
        cartDrawer: {{ settings.cart_drawer | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }}
        },
        strings: {
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          sold_out: {{ 'products.product.sold_out' | t | json }},
          cart_error: {{ 'cart.general.error' | t | json }},
          save_percent: {{ string_save_percent | json }},
          save_percent_short: {{ string_save_short | json }},
          per_bottle: {{ string_per_bottle | json }}
        }
      };
    </script>

    <script src="{{ 'myhaut.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="mh-skip" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'mh-cart-drawer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.skip_to_content' | t }}</li>
    </ul>
  </body>
</html>
