<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'myhaut.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --mh-bg: {{ settings.color_background }};
        --mh-rose: {{ settings.color_accent }};
        --mh-ink: {{ settings.color_ink }};
      }
      .mh-password {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 22px;
      }
    </style>
  </head>
  <body>
    <div class="mh-password">
      <div>{{ content_for_layout }}</div>
    </div>
  </body>
</html>
